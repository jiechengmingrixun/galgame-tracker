# ==========================================================
#  Galgame Tracker · 环境变量示例
#  复制为 `.env` 并填入真实值；不要把真实 `.env` 提交到 Git
# ==========================================================

# ----- Supabase -----
# 在 Supabase Dashboard → Project Settings → API 里获取
VITE_SUPABASE_URL=https://你的项目ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxx

# ----- Vercel（Edge Function） -----
# VNDB API 需要一个 User-Agent（VNDB 官方要求）
VNDB_USER_AGENT=galgame-tracker/0.1 (https://your-domain; your@email)

# ----- Backblaze B2（仅 Edge Function 使用，前端无需配置） -----
# 在 Backblaze B2 → App Keys 创建 S3 兼容密钥
B2_ACCESS_KEY_ID=004xxxxxxxxxxxxxxxxxxxxxxx
B2_SECRET_ACCESS_KEY=K004xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# B2 桶名
B2_BUCKET_NAME=你的-b2桶名
# B2 S3 Endpoint（美西004区默认是下面这个）
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
